<Page
    x:Class="LumINE.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumINE.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="24,0" MaxWidth="400">
            <TextBlock Text="LumINE" FontSize="36" FontWeight="Bold" Foreground="#06C755" HorizontalAlignment="Center" Margin="0,0,0,60"/>
            <TextBlock Text="メールアドレス" Foreground="#06C755" FontSize="14" Margin="0,0,0,6"/>
            <TextBox x:Name="EmailBox" Margin="0,0,0,20" PlaceholderText="example@line.com" Height="40"/>
            <TextBlock Text="パスワード" Foreground="#06C755" FontSize="14" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,32" PlaceholderText="パスワード" Height="40"/>
            <Button Content="ログイン" Click="LoginButton_Click" HorizontalAlignment="Stretch" Background="#06C755" Foreground="White" Height="44" FontSize="16"/>
            <TextBox x:Name="StatusText" Foreground="#06C755" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Margin="0,24,0,0" FontSize="12" TextAlignment="Center" Height="80"/>
            <!-- <Button Content="コピー" Click="CopyButton_Click" HorizontalAlignment="Center" Margin="0,8,0,0" Background="#06C755" Foreground="White"/>-->
        </StackPanel>
    </Grid>
</Page>
