<Page x:Class="LumINE.Views.UnlockPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#3F4663" RequestedTheme="Light">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="420" Margin="28">
        <TextBlock Text="LumINE" Foreground="White" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock x:Name="StatusText" Text="本人確認してください。" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <Button x:Name="UnlockButton" Content="ロックを解除" Click="Unlock_Click" HorizontalAlignment="Stretch" Background="White" Foreground="#3F4663"/>
        <ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="False" Foreground="White" Margin="0,16,0,0"/>
    </StackPanel>
</Page>
