<Page
    x:Class="LumINE.Views.ChatRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumINE.Views"
    xmlns:vm="using:LumINE.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="#F2F2F2">

    <Page.Resources>
        <vm:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <vm:MessageBackgroundConverter x:Key="MessageBackgroundConverter"/>
        <vm:MessageForegroundConverter x:Key="MessageForegroundConverter"/>
        <vm:BoolVisibilityConverter x:Key="BoolVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#3F4663" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹" Click="BackButton_Click" Background="Transparent"
                    Foreground="White" BorderThickness="0" FontSize="28" Padding="0,-5,0,0"/>
            <TextBlock x:Name="ChatNameText" Grid.Column="1" Foreground="White" FontSize="16"
                       VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                    Click="SearchButton_Click" Background="Transparent" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="トーク内を検索"/>
        </Grid>
        <ListView x:Name="MessagesList" Grid.Row="1" ItemsSource="{Binding Messages}" Background="#F2F2F2"
                  HorizontalContentAlignment="Stretch" IsSwipeEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3" HorizontalAlignment="Stretch">
                        <Border Visibility="{Binding IsDateSeparator, Converter={StaticResource BoolVisibilityConverter}}"
                                Background="#E8EAF0" CornerRadius="4" Padding="14,6"
                                HorizontalAlignment="Center" Margin="0,8,0,8">
                            <TextBlock Text="{Binding DateLabel}" Foreground="#777777" FontSize="12"/>
                        </Border>
                        <Grid Visibility="{Binding IsMessageItem, Converter={StaticResource BoolVisibilityConverter}}"
                              HorizontalAlignment="Stretch" ManipulationMode="TranslateX,System"
                              ManipulationStarted="MessageSwipe_Started" ManipulationDelta="MessageSwipe_Delta" ManipulationCompleted="MessageSwipe_Completed">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="返信" Click="ReplyMenu_Click" CommandParameter="{Binding}"/>
                                    <MenuFlyoutItem Text="コピー" Click="CopyMenu_Click" CommandParameter="{Binding}"/>
                                    <MenuFlyoutItem Text="リアクション" Click="ReactionMenu_Click" CommandParameter="{Binding}"/>
                                    <MenuFlyoutItem Text="送信を取り消す" Click="UnsendMenu_Click" CommandParameter="{Binding}" Visibility="{Binding CanUnsend, Converter={StaticResource BoolVisibilityConverter}}"/>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                                  Visibility="{Binding ShowPeerInfo, Converter={StaticResource BoolVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,7,18">
                                    <Ellipse Fill="#DDDDDD"/>
                                    <Ellipse>
                                        <Ellipse.Fill><ImageBrush ImageSource="{Binding SenderAvatar}" Stretch="UniformToFill"/></Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1" MaxWidth="420" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SenderName}" FontSize="11" Foreground="#666666" Margin="4,0,0,2"/>
                                    <Border Background="{Binding Converter={StaticResource MessageBackgroundConverter}}"
                                            CornerRadius="16" Padding="12,8" Margin="0,0,4,2">
                                        <StackPanel>
                                            <Border Background="#1A000000" Padding="7,4" Margin="0,0,0,5" Visibility="{Binding HasReply, Converter={StaticResource BoolVisibilityConverter}}">
                                                <TextBlock Text="{Binding ReplyPreview}" FontSize="12" Foreground="#777777" TextWrapping="Wrap" MaxLines="2"/>
                                            </Border>
                                            <local:ChatMediaView Source="{Binding MediaImage}" Message="{Binding}" PhotoTapped="Photo_Tapped" MaxWidth="{Binding MediaMaxWidth}" MaxHeight="280"
                                                   Visibility="{Binding HasMediaImage, Converter={StaticResource BoolVisibilityConverter}}"/>
                                            <RichTextBlock local:MessageText.Value="{Binding DisplayText}" FontSize="{Binding BodyFontSize}" Foreground="{Binding Converter={StaticResource MessageForegroundConverter}}"
                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="{Binding IsText, Converter={StaticResource BoolVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding MediaFallbackText}" FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                                       Visibility="{Binding ShowMediaFallback, Converter={StaticResource BoolVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ReactionSummary}" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#444444" TextWrapping="Wrap" Margin="4,2"
                                               Visibility="{Binding HasReactions, Converter={StaticResource BoolVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#888888" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" MaxWidth="420"
                                        Visibility="{Binding IsMine, Converter={StaticResource BoolVisibilityConverter}}">
                                <Border Background="{Binding Converter={StaticResource MessageBackgroundConverter}}"
                                        CornerRadius="16" Padding="12,8" Margin="4,13,2,2">
                                    <StackPanel>
                                        <Border Background="#1A000000" Padding="7,4" Margin="0,0,0,5" Visibility="{Binding HasReply, Converter={StaticResource BoolVisibilityConverter}}">
                                            <TextBlock Text="{Binding ReplyPreview}" FontSize="12" Foreground="#777777" TextWrapping="Wrap" MaxLines="2"/>
                                        </Border>
                                        <local:ChatMediaView Source="{Binding MediaImage}" Message="{Binding}" PhotoTapped="Photo_Tapped" MaxWidth="{Binding MediaMaxWidth}" MaxHeight="280"
                                               Visibility="{Binding HasMediaImage, Converter={StaticResource BoolVisibilityConverter}}"/>
                                        <RichTextBlock local:MessageText.Value="{Binding DisplayText}" FontSize="{Binding BodyFontSize}" Foreground="{Binding Converter={StaticResource MessageForegroundConverter}}"
                                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="{Binding IsText, Converter={StaticResource BoolVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding MediaFallbackText}" FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                                   Visibility="{Binding ShowMediaFallback, Converter={StaticResource BoolVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding ReactionSummary}" FontFamily="Segoe UI Emoji" FontSize="13" Foreground="#444444" TextWrapping="Wrap" Margin="4,2" HorizontalAlignment="Right"
                                           Visibility="{Binding HasReactions, Converter={StaticResource BoolVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding ReadLabel}" FontSize="10" Foreground="#888888"
                                               Margin="0,0,5,0" Visibility="{Binding ShowReadLabel, Converter={StaticResource BoolVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2">
            <Grid Background="#E8EBF1" Padding="6,4" Visibility="{Binding HasReplyTarget, Converter={StaticResource BoolVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#596173"
                        Click="CancelReply_Click" AutomationProperties.Name="返信をキャンセル" ToolTipService.ToolTip="返信をキャンセル"/>
                <TextBlock Grid.Column="1" Text="{Binding ReplyTargetPreview}" Foreground="#596173" TextWrapping="Wrap" MaxLines="2" Margin="8,0" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#B00020" TextWrapping="Wrap" Margin="12,2"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolVisibilityConverter}}"/>
        </StackPanel>
        <ProgressBar Grid.Row="3" Height="3" MinHeight="3" Margin="0" Foreground="#06C755" Background="Transparent"
                     IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibilityConverter}}" AutomationProperties.Name="処理中"/>
        <Grid Grid.Row="4" Background="#FFFFFF" Padding="6" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="&#xE16C;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                    Click="PhotoButton_Click" Background="Transparent" Foreground="#8A8F98" BorderThickness="0" Padding="8,4"/>
            <TextBox x:Name="MessageInput" Grid.Column="1" Text="{Binding MessageText, Mode=TwoWay}"
                     PlaceholderText="メッセージを入力してください。" Background="White" Foreground="#222222" BorderBrush="#66FFFFFF"/>
            <Button Grid.Column="2" Content="&#xE170;" FontFamily="Segoe MDL2 Assets" FontSize="22" Click="StickerButton_Click" Background="Transparent" Foreground="#8A8F98" BorderThickness="0" Padding="4,4"/>
            <Button Grid.Column="3" Content="&#xE122;" FontFamily="Segoe MDL2 Assets" FontSize="21" Margin="6,0,0,0"
                    Click="SendButton_Click" Background="#06C755" Foreground="White" BorderThickness="0" Padding="12,6"/>
        </Grid>
    </Grid>
</Page>
