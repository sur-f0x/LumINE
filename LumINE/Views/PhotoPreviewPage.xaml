<Page x:Class="LumINE.Views.PhotoPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:LumINE.ViewModels"
      RequestedTheme="Light" Background="#15171C">
    <Page.Resources><vm:BoolVisibilityConverter x:Key="BoolVisibilityConverter"/></Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Background="#3F4663">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="‹" Click="BackButton_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="28" Padding="0,-5,0,0" AutomationProperties.Name="戻る"/>
            <TextBlock Grid.Column="1" Text="写真" Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="8,0"/>
        </Grid>
        <ScrollViewer x:Name="PhotoScroller" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="PreviewImage" Stretch="Uniform" Width="{Binding ActualWidth, ElementName=PhotoScroller}"
                   Height="{Binding ActualHeight, ElementName=PhotoScroller}"/>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#E0E3EB" FontSize="12" TextWrapping="Wrap" Margin="12,6"/>
        <ProgressBar Grid.Row="3" Height="3" MinHeight="3" Foreground="#06C755" Background="Transparent" Margin="0"
                     IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibilityConverter}}" AutomationProperties.Name="処理中"/>
        <CommandBar Grid.Row="4" Background="#F1F2F6" Foreground="#70798C" ClosedDisplayMode="Compact" IsDynamicOverflowEnabled="False">
            <AppBarButton x:Name="DownloadButton" Icon="Download" Label="ダウンロード" Click="DownloadButton_Click" IsEnabled="False"/>
        </CommandBar>
    </Grid>
</Page>
