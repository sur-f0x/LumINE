<Page x:Class="LumINE.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LumINE.ViewModels" RequestedTheme="Light" Background="#F4F5F8">
    <Page.Resources><vm:BoolVisibilityConverter x:Key="BoolVisibilityConverter"/></Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="#3F4663"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="‹" Click="BackButton_Click" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="28" Padding="0,-5,0,0" AutomationProperties.Name="戻る"/>
            <TextBlock Grid.Column="1" Text="設定" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,14" MaxWidth="600" HorizontalAlignment="Stretch">
                <TextBlock Text="通知" FontSize="18" Foreground="#3F4663" Margin="0,0,0,10"/>
                <ToggleSwitch x:Name="NotificationsToggle" Header="バックグラウンド通知" OnContent="オン" OffContent="オフ"/>
                <TextBlock Text="再起動後は定期・ロック解除・接続復旧時に確認します。即時の常駐待受を再開するには、一度LumINEを開いてください。" TextWrapping="Wrap" Foreground="#666666" Margin="0,6,0,12"/>
                <ToggleSwitch x:Name="HideContentToggle" Header="通知にメッセージ内容を表示しない" OnContent="新規メッセージと表示" OffContent="本文を表示"/>
                <TextBlock Text="オンにすると通知・ライブタイルの本文を「新規メッセージ」に置き換えます。保存時に、それまでの通知履歴も消去します。" TextWrapping="Wrap" Foreground="#666666" Margin="0,6,0,12"/>
                <Button Content="通知をテスト" Click="TestNotification_Click" Margin="0,0,0,8"/>
                <Button Content="ロック画面の設定を開く" Click="LockScreen_Click"/>
                <TextBlock Text="件数を表示するには、Windowsのロック画面設定の「状態の概要を表示するアプリ」でLumINEを選択してください。タイルの本文は中サイズ・横長で表示します。" TextWrapping="Wrap" Foreground="#666666" Margin="0,8,0,12"/>
                <TextBlock x:Name="NotificationStatusText" TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,0,0,20"/>
                <TextBlock Text="トーク表示" FontSize="18" Foreground="#3F4663" Margin="0,0,0,10"/>
                <ToggleSwitch x:Name="AnimateToggle" Header="動くスタンプをアニメーション表示" OnContent="オン" OffContent="静止画で表示"/>
                <TextBlock Text="オフにすると、スタンプを静止画で表示して処理負荷を抑えます。" TextWrapping="Wrap" Foreground="#666666" Margin="0,6,0,20"/>
                <ToggleSwitch x:Name="StickerSoundToggle" Header="スタンプの音の再生" OnContent="オン" OffContent="オフ"/>
                <TextBlock Text="初回表示・送信・タップ時に音声付きスタンプの音を再生します。オフにするとタップ時も再生しません。" TextWrapping="Wrap" Foreground="#666666" Margin="0,6,0,20"/>
                <TextBlock Text="セキュリティ" FontSize="18" Foreground="#3F4663" Margin="0,0,0,10"/>
                <ToggleSwitch x:Name="HelloToggle" Header="起動時にWindows Helloで認証" OnContent="オン" OffContent="オフ"/>
                <TextBlock Text="アプリを起動したときに、端末のPIN・虹彩・指紋などWindowsが提供する認証を要求します。オン・オフの変更時にも本人確認を行います。端末側でサインインオプションを設定してください。" TextWrapping="Wrap" Foreground="#666666" Margin="0,6,0,20"/>
                <TextBlock Text="LumINE 1.1" FontSize="18" Foreground="#3F4663" Margin="0,0,0,10"/>
                <Button Content="謝辞・ライセンス" Click="Attributions_Click" Margin="0,0,0,16"/>
                <Button Content="ログアウト" Click="Logout_Click" Foreground="#B00020"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#B00020" Margin="0,12,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <ProgressBar Grid.Row="2" Height="3" MinHeight="3" Margin="0" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibilityConverter}}" Foreground="#06C755"/>
        <CommandBar Grid.Row="3" Background="#F1F2F6" Foreground="#70798C" ClosedDisplayMode="Compact"><AppBarButton x:Name="SaveButton" Icon="Save" Label="保存" Click="Save_Click"/></CommandBar>
    </Grid>
</Page>
